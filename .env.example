APP_CONFIG__DB__USER=postgres
APP_CONFIG__DB__PASSWORD=change_me
APP_CONFIG__DB__HOST=postgres
APP_CONFIG__DB__PORT=5432
APP_CONFIG__DB__NAME=schoolhub_school
APP_CONFIG__DB__POOL_SIZE=10
APP_CONFIG__DB__MAX_OVERFLOW=20
APP_CONFIG__DB__POOL_RECYCLE_SECONDS=1800

APP_CONFIG__API__V1_PREFIX=/v1
APP_CONFIG__API__HOST=0.0.0.0
APP_CONFIG__API__PORT=8000
APP_CONFIG__API__RELOAD=false
APP_CONFIG__LOGGING__LEVEL=INFO

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=schoolhub_school

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

APP_CONFIG__MIDDLEWARE__ALLOW_ORIGINS=["*"]
APP_CONFIG__MIDDLEWARE__ALLOW_METHODS=["*"]
APP_CONFIG__MIDDLEWARE__ALLOW_HEADERS=["*"]
APP_CONFIG__MIDDLEWARE__ALLOW_CREDENTIALS=false

APP_CONFIG__KAFKA__BOOTSTRAP_SERVERS=kafka:29092
APP_CONFIG__KAFKA__CLIENT_ID=school-service
APP_CONFIG__KAFKA__ACKS=all
APP_CONFIG__KAFKA__TOPIC=school.events
APP_CONFIG__KAFKA__REQUEST_TIMEOUT_MS=10000
APP_CONFIG__KAFKA__LINGER_MS=5
APP_CONFIG__KAFKA__COMPRESSION_TYPE=gzip

APP_CONFIG__REDIS__HOST=redis
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__DATABASE=0
APP_CONFIG__REDIS__DEFAULT_TTL_SECONDS=300
APP_CONFIG__REDIS__KEY_PREFIX=school-service
